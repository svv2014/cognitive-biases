{
  "name": "cognitive-biases",
  "version": "2.0.0",
  "private": true,
  "description": "A searchable, multilingual reference of 62 cognitive biases — 50 human, 12 from the age of AI.",
  "type": "module",
  "license": "GPL-3.0",
  "homepage": "https://svv2014.github.io/cognitive-biases/",
  "repository": {
    "type": "git",
